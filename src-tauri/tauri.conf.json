{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OzenDB",
  "version": "0.1.3",
  "identifier": "com.ozendb.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OzenDB",
        "maximized": true,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "./linux/main.desktop"
      },
      "rpm": {
        "desktopTemplate": "./linux/main.desktop"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
